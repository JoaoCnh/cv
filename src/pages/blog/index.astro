---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
import { cv } from '../../data/cv';
import { SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={`Blog | ${cv.name}`} name={cv.name} description={SITE_DESCRIPTION}>
  <main class="blog">
    <header class="intro">
      <h1>Blog</h1>
      <p>Notes on frontend engineering, performance, testing and the things I build.</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">No posts yet. Check back soon.</p>
      ) : (
        <ul class="posts">
          {posts.map((post, index) => (
            <li>
              <a class="card" href={`/blog/${post.id}/`}>
                {post.data.heroImage && (
                  <Image width={720} height={360} src={post.data.heroImage} alt="" loading={index === 0 ? "eager" : "lazy"} />
                )}
                <div class="card-body">
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                  <h2 class="title">{post.data.title}</h2>
                  {post.data.description && <p class="desc">{post.data.description}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>

<style>
  .blog {
    max-width: 52rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  /* echoes the CV masthead: big uppercase title over a thick grey rule */
  .intro {
    padding-bottom: 0.75rem;
    margin-bottom: 2rem;
    border-bottom: 6px solid var(--rule);
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .intro p {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }

  .empty {
    color: var(--muted);
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* the newest post gets the full width */
  .posts li:first-child {
    grid-column: 1 / -1;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--muted);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  /* <Image> renders its own <img>, which scoped styles can't reach without :global */
  .card :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem 1.25rem;
  }

  .date {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .title {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .posts li:first-child .title {
    font-size: 1.75rem;
  }

  .desc {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.95rem;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 40rem) {
    .posts {
      grid-template-columns: 1fr;
    }

    .posts li:first-child .title {
      font-size: 1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>