---
import Header from '../components/Header.astro';
import BaseHead from '../components/BaseHead.astro';
import {DownloadButton} from '../components/react/DownloadButton';

interface Props {
  title: string;
  name: string;
  description?: string;
}

const { title, name, description = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header name={name} />
    <slot />
    <DownloadButton client:only="react" href="/joao-cunha-cv.pdf" filename="Joao-Cunha-CV.pdf" />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fff;
    --text: #111;
    --muted: #444;
    --rule: #e5e5e5;
    --link: #111;
    --header-bg: rgb(255 255 255 / 0.85);
    color-scheme: light dark;
  }

  /* Follows the visitor's system setting; no toggle needed */
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121212;
      --text: #f2f2f2;
      --muted: #b5b5b5;
      --rule: #2e2e2e;
      --link: #f2f2f2;
      --header-bg: rgb(18 18 18 / 0.85);
    }
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 4rem; /* keeps anchored sections clear of the sticky header */
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Print / PDF */
  @page {
    size: A4;
    margin: 14mm 16mm;
  }

  @media print {
    :root {
      --bg: #fff;
      --text: #111;
      --muted: #444;
      --rule: #e5e5e5;
      --link: #111;
    }

    body {
      font-size: 10pt;
      line-height: 1.4;
    }

    h2,
    h3 {
      break-after: avoid;
    }

    li {
      break-inside: avoid;
    }
  }
</style>